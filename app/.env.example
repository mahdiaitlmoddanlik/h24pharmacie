# Public site URL used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL="https://h24pharmacie.com"

# Server-only PostgreSQL connections. Use the transaction pooler for Next.js
# and the session pooler for the scraper's longer atomic refreshes.
DATABASE_URL="postgresql://pharmacies_app.PROJECT_REF:YOUR_APP_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://pharmacies_app.PROJECT_REF:YOUR_APP_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# Private values. Generate strong random strings and never commit .env.local.
ADMIN_REPORT_TOKEN="replace-with-a-random-token-at-least-32-characters-long"
REPORT_IP_HASH_SALT="replace-with-a-random-private-salt"
