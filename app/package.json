{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test src/lib/dates.test.ts src/lib/neighborhoods.test.ts src/lib/data/index.test.ts src/scripts/parse-saydalia.test.ts src/scripts/parse-telecontact.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "scrape:inspect": "tsx src/scripts/inspect-saydalia.ts",
    "scrape:saydalia": "tsx src/scripts/scrape-saydalia.ts",
    "scrape:marrakech": "tsx src/scripts/scrape-syndicat-marrakech.ts",
    "scrape:telecontact": "tsx src/scripts/scrape-telecontact.ts",
    "scrape:update": "tsx src/scripts/update-duty-schedules.ts",
    "scrape:refresh": "npm run scrape:marrakech -- --out tmp/syndicat-marrakech-latest.json && npm run scrape:update -- --file tmp/syndicat-marrakech-latest.json && npm run scrape:telecontact -- --out tmp/telecontact-latest.json && npm run scrape:update -- --file tmp/telecontact-latest.json",
    "icons:generate": "powershell -ExecutionPolicy Bypass -File scripts/generate-pwa-icons.ps1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "next": "16.2.9",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
